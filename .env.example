# =============================================================================
#  Copy to .env and adjust. .env is gitignored; this template is not.
#
#      cp .env.example .env
#      docker compose up --build
#
#  Every value here has a working default in docker-compose.yml, so the stack
#  runs without a .env at all. Create one when you want to change something.
# =============================================================================

# --- JWT ---------------------------------------------------------------------
# Signed by auth-service, verified by the other three, so all four MUST receive
# the identical value. At least 32 bytes - HS256 refuses anything shorter, and
# a short secret is a forgeable token.
#
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# --- PostgreSQL --------------------------------------------------------------
# Superuser, used only to create the four service databases on first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# One least-privilege role per service. These must match
# docker/postgres/init/00-create-databases.sql, which runs ONCE on an empty
# volume - changing them later also means: docker compose down -v
AUTH_DB_PASSWORD=auth_dev_pwd
PROFILE_DB_PASSWORD=profile_dev_pwd
POST_DB_PASSWORD=post_dev_pwd
LIKE_DB_PASSWORD=like_dev_pwd

# --- Application -------------------------------------------------------------
GATEWAY_URL=http://localhost:8080

# Creates the five demo accounts, five posts and twelve likes on startup.
# Set to false for a clean, empty database.
APP_SEEDER_ENABLED=true

# Angular dev server and the gateway. Never "*" - the spec forbids combining a
# wildcard with credentials, so it would break the very requests it looks like
# it permits.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
